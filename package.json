        "lint": "tsc --noEmit -p config/config-ts-test.json",
        "prepack": "npm run build"
    },
    "dependencies": {
        "basic-ftp": "6.2.1"
    },
    "devDependencies": {
        "@types/node": "24.13.3",
        "nuckty": "file:../nuckty",
